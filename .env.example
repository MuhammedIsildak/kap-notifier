# Gmail SMTP (uygulama şifresi; normal Gmail şifresi değil)
KAP_SMTP_HOST=smtp.gmail.com
KAP_SMTP_PORT=465
KAP_SMTP_USER=ornek@gmail.com
KAP_SMTP_PASS=xxxx xxxx xxxx xxxx
KAP_EMAIL_FROM=ornek@gmail.com
KAP_EMAIL_TO=ornek@gmail.com

# Opsiyonel: Gemini ile Türkçe özet. Boşsa KAP özeti kullanılır.
GEMINI_API_KEY=

# Lokal state klasörü (varsayılan: ./state)
KAP_STATE_DIR=state